# Copy to .env and set secure values
# Example values - replace before use

# URL publica do Vaultwarden (com https)
DOMAIN=https://senhas.seu-dominio.duckdns.org

# Permitir novos cadastros (true/false)
SIGNUPS_ALLOWED=true

# WebSocket habilitado
WEBSOCKET_ENABLED=true

# Token de admin (obrigatorio) - use um valor forte; nunca comite o valor real
ADMIN_TOKEN=replace-with-secure-admin-token

# SMTP (ex: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=your-email@gmail.com
SMTP_USERNAME=your-email@gmail.com
# Senha de aplicativo do Gmail (obrigatoria) - nunca comite o valor real
SMTP_PASSWORD=replace-with-app-password
