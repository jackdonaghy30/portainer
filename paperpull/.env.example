# PaperPull Server - exemplo de .env
# Copie este arquivo para `.env` na mesma pasta do `docker-compose.yml` e ajuste.

# Versão da imagem ghcr.io/rheeloaded/paperpull-server
PAPERPULL_VERSION=0.71.0

# Porta do painel no host
PAPERPULL_PORT=8765

# Usuário/Grupo dono dos documentos salvos
PUID=1000
PGID=1000

# Timezone
TZ=America/Sao_Paulo

# Pasta onde os documentos baixados são salvos
DATA_LOCATION=./data

# Senha do painel (mínimo 10 caracteres). Opcional: se vazio, é definida no primeiro acesso
# usando o código exibido em `docker logs paperpull`.
PAPERPULL_PASSWORD=

# Nomes extras (VPN, reverse proxy) pelos quais o painel responde, separados por vírgula
#PAPERPULL_HOSTS=paperpull.example.com
# 1 faz o painel responder apenas aos nomes listados em PAPERPULL_HOSTS
PAPERPULL_HOSTS_ONLY=

# Paperless-ngx (opcional): pasta consume e subpastas por provedor (1 para ativar)
#PAPERLESS_CONSUME_LOCATION=/path/to/paperless/consume
PAPERLESS_SUBFOLDERS=
