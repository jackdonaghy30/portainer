# Revisão do AFFiNE (stable, beta ou canary)
AFFINE_REVISION=stable

# Porta HTTP do AFFiNE no host
PORT=3010

# URL pública da instância (recomendado em produção com HTTPS)
# Exemplo: https://affine.seudominio.com
AFFINE_SERVER_EXTERNAL_URL=

# Habilita o indexador interno (false para reduzir consumo inicial)
AFFINE_INDEXER_ENABLED=false

# Caminho dos dados do PostgreSQL
DB_DATA_LOCATION=./postgres

# Caminho dos arquivos enviados (blobs)
UPLOAD_LOCATION=./storage

# Caminho das configurações persistentes do AFFiNE
CONFIG_LOCATION=./config

# Credenciais do banco de dados
DB_USERNAME=affine
DB_PASSWORD=replace-with-strong-password
DB_DATABASE=affine
