# Timezone
TZ=America/Sao_Paulo

# Interface e porta exposta na máquina host
LAYA_HOST=0.0.0.0
LAYA_PORT=8080

# Imagem do container (ajuste conforme a imagem oficial publicada pela Laya AI)
LAYA_IMAGE=ghcr.io/laya-ai/playground:latest

# Chave opcional para autenticação/segurança do playground
LAYA_API_KEY=replace-with-secure-token
